# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен бота: @BotFather → /newbot
TG_BOT_TOKEN=

# Ваш числовой id в Telegram — его покажет @userinfobot.
# Только этот пользователь может управлять двойником и обучать его.
TG_OWNER_ID=

# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
